# Environment Variables for Ghero E-commerce Platform
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ============================================
# DATABASE
# ============================================
# Serverless Postgres (e.g. Neon) pauses when idle and can take several seconds to wake:
# append `connect_timeout=30&pool_timeout=30` to both URLs so the first request waits instead of failing.
# Named GHERO_DATABASE_URL (not DATABASE_URL) so a machine-wide DATABASE_URL
# from another project can never override it.
GHERO_DATABASE_URL="postgresql://user:password@localhost:5432/ghero?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate. Same as GHERO_DATABASE_URL unless
# it goes through a pooler (e.g. Neon "-pooler" host).
DIRECT_URL="postgresql://user:password@localhost:5432/ghero?schema=public"

# ============================================
# APPLICATION
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ghero by Kajal Soni"

# ============================================
# AUTHENTICATION / SESSIONS
# ============================================
# Secret for signing session cookies (generate with: openssl rand -base64 32)
SESSION_SECRET="your-session-secret-here"

# ============================================
# RAZORPAY (Payment Gateway)
# ============================================
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ============================================
# CLOUDINARY (Media Storage)
# ============================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ============================================
# EMAIL (Google SMTP)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Ghero by Kajal Soni <your-email@gmail.com>"
# Where contact-form messages are delivered (falls back to ADMIN_EMAIL)
STORE_CONTACT_EMAIL="gherobykajalsoni@gmail.com"

# ============================================
# WHATSAPP (Meta Cloud API - Optional)
# ============================================
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER="meta"
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# ============================================
# ADMIN
# ============================================
# Email for initial admin account (created via seed)
ADMIN_EMAIL="admin@gherobykajalsoni.com"
